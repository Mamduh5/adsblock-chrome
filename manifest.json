{
  "manifest_version": 3,
  "name": "Site Shield",
  "version": "0.2.0",
  "description": "A local-only, profile-based site shield for selected desktop Chrome sites.",
  "permissions": [
    "alarms",
    "cookies",
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "*://mangakakalot.gg/*",
    "*://www.mangakakalot.gg/*"
  ],
  "background": {
    "service_worker": "src/background/service_worker.js"
  },
  "action": {
    "default_title": "Site Shield",
    "default_popup": "src/popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://mangakakalot.gg/*",
        "*://www.mangakakalot.gg/*"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "css": [
        "src/content/content.css"
      ],
      "js": [
        "src/profiles/schema.js",
        "src/profiles/sites/mangakakalot.js",
        "src/profiles/index.js",
        "src/shared/config.js",
        "src/shared/heuristics.js",
        "src/content/content.js"
      ]
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "site_shield_static",
        "enabled": true,
        "path": "rules/static_rules.json"
      }
    ]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "src/content/page_guard.js"
      ],
      "matches": [
        "*://mangakakalot.gg/*",
        "*://www.mangakakalot.gg/*"
      ]
    }
  ]
}
